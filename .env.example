# Server
PORT=3000

# The bearer token clients must send as `Authorization: Bearer <AUTH_TOKEN>`
# for every /v1/* route. Generate a random string for submission.
AUTH_TOKEN=change-me

# LLM provider (only needed for options.provider = "llm").
# Any OpenAI-compatible vendor works out of the box by pointing LLM_BASE_URL
# at it (OpenRouter, Groq, OpenAI itself, ...). Set LLM_VENDOR=anthropic to
# use Anthropic's native Messages API instead.
LLM_VENDOR=openrouter
LLM_API_KEY=
LLM_MODEL=
# Ordered, comma-separated fallback chain, strongest first (tried in order
# after LLM_MODEL if it fails):
LLM_FALLBACK_MODELS=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_MS=27000

# Optional OpenRouter-recommended attribution headers.
LLM_HTTP_REFERER=
LLM_APP_TITLE=
